# Copiar a .env en la raíz del repositorio. Nunca se versiona .env ni se ponen valores reales aquí.

# dev habilita la identidad temporal por cabecera X-User-Id (solo hasta la clase 10)
ENV=dev
# stub (sin LLM) o real (motor de ai/)
ENGINE=stub
# Límite de documentos; 413 si se excede
MAX_UPLOAD_MB=10

# Desde la clase 8
DATABASE_URL=

# Credenciales de laboratorio con límite de costo
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Desde la clase 11
MCP_SERVER_URL=
A2A_AGENT_URL=

# Desde la clase 10
JWT_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
